{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCue",
  "version": "0.1.0",
  "identifier": "im.opencue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCue",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Personal AI agents on your desktop",
    "longDescription": "OpenCue lets you create personal AI agents with their own instructions, memory, tools and group chats.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
