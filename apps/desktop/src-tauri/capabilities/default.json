{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and floating window permissions",
  "windows": ["main", "float-*", "notch"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
